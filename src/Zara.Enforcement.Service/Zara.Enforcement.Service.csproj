<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Zara.Enforcement.Service</AssemblyName>
    <RootNamespace>Zara.Enforcement.Service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zara.Supervision.Contracts\Zara.Supervision.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <!-- The installer places both executables beside the same Windows Desktop runtime. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
</Project>
