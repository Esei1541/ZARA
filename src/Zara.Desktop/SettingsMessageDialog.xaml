<Window x:Class="Zara.Desktop.SettingsMessageDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="510" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Background="Transparent" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Styles/SettingsStyles.xaml" />
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Border Background="{StaticResource Zara.Brush.Surface}" BorderBrush="{StaticResource Zara.Brush.Border}"
          BorderThickness="1" CornerRadius="12" Padding="24"
          TextElement.FontFamily="{StaticResource Zara.Font.Family}" TextElement.FontSize="14" TextElement.Foreground="{StaticResource Zara.Brush.Text}">
    <StackPanel>
      <Grid Margin="0,0,0,22">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Zara.SectionTitle}" VerticalAlignment="Center" />
        <Button HorizontalAlignment="Right" Style="{StaticResource Zara.DialogCloseButton}" IsCancel="True" Content="×" AutomationProperties.Name="닫기" />
      </Grid>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
      <Border x:Name="DetailsPanel" Background="{StaticResource Zara.Brush.Background}" Padding="14" CornerRadius="8" Margin="0,16,0,0">
        <TextBlock x:Name="DetailsText" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button x:Name="CancelButton" Content="취소" IsCancel="True" Style="{StaticResource Zara.Button}" Margin="0,0,8,0" />
        <Button x:Name="AcceptButton" Style="{StaticResource Zara.PrimaryButton}" Click="Accept_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
