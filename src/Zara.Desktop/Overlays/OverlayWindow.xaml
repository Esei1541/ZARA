<Window x:Class="Zara.Desktop.Overlays.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="시스템 잠금 중"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="#FF12151C">
  <Grid>
    <Border Width="620"
            Padding="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#F2242832"
            BorderBrush="#FF4B5362"
            BorderThickness="1"
            CornerRadius="18">
      <StackPanel HorizontalAlignment="Center">
        <Image Width="104"
               Height="104"
               Source="/Zara.Desktop;component/Assets/ZaraIcon.png"
               Stretch="Uniform" />
        <TextBlock Margin="0,22,0,0"
                   HorizontalAlignment="Center"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Text="시스템 잠금 중" />
        <TextBlock Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#FFD1D6DE"
                   Text="지금은 PC 사용이 불가능한 시각입니다."
                   TextAlignment="Center" />
        <TextBlock Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#FF929AA7"
                   Text="사용 가능한 시각이 되면 잠금이 해제됩니다. 주무세요!"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <WrapPanel x:Name="LockActions"
                   Margin="0,28,0,0"
                   HorizontalAlignment="Center"
                   Orientation="Horizontal">
          <Button x:Name="EmergencyUnlockButton"
                  MinWidth="152"
                  Height="42"
                  Margin="4,0"
                  Padding="18,0"
                  Click="EmergencyUnlock_Click"
                  Content="긴급 해제" />
          <Button x:Name="SystemShutdownButton"
                  MinWidth="152"
                  Height="42"
                  Margin="4,0"
                  Padding="18,0"
                  Click="SystemShutdown_Click"
                  Content="시스템 종료"
                  FontWeight="SemiBold" />

        </WrapPanel>
      </StackPanel>
    </Border>
    <TextBlock x:Name="RecoveryStatus"
               Margin="24"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Foreground="#FFD1D6DE"
               FontSize="16"
               Text="잠금 오류 복원 중..."
               Visibility="Collapsed" />
  </Grid>
</Window>
