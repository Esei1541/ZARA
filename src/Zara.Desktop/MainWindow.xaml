<Window x:Class="Zara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Zara.Desktop.Behaviors"
        xmlns:local="clr-namespace:Zara.Desktop"
        Title="ZARA"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        Icon="Assets/ZaraIcon.png"
        Background="#FFF7F8FA"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel LastChildFill="True">
      <Border Width="52"
              Height="52"
              Margin="0,0,16,0"
              Padding="8"
              Background="#FF171A21"
              CornerRadius="12"
              DockPanel.Dock="Left">
        <Image Source="Assets/ZaraIcon.png" Stretch="Uniform" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="26"
                   FontWeight="SemiBold"
                   Text="ZARA" />
        <TextBlock Margin="0,2,0,0"
                   Foreground="#FF5C6470"
                   TextWrapping="Wrap"
                   Text="{Binding UsagePolicyStatusMessage}" />
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="MainTabs"
                Grid.Row="2"
                SelectionChanged="MainTabs_SelectionChanged">
      <TabItem x:Name="BasicSettingsTab" Header="기본">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="실행 설정" />
          <StackPanel Grid.Row="2">
            <CheckBox Content="잠금이 해제된 상태에서도 프로그램이 종료되면 자동으로 다시 실행"
                      IsChecked="{Binding RestartOnExitWhenUnlocked, Mode=TwoWay}"
                      IsEnabled="{Binding CanEditExecutionSettings}"
                      VerticalContentAlignment="Center" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#FF5C6470"
                       TextWrapping="Wrap"
                       Text="(시스템 트레이에서 직접 종료 시에는 실행되지 않습니다. 잠금 시각에는 설정과 관계 없이 실행됩니다.)" />
            <StackPanel Margin="0,24,0,0">
              <TextBlock FontWeight="SemiBold"
                         Text="음성 안내" />
              <TextBlock Margin="0,6,0,0"
                         Foreground="#FF5C6470"
                         TextWrapping="Wrap"
                         Text="잠금 시각이 다가오면 음성 안내를 출력합니다." />
              <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <CheckBox Margin="0,0,24,0"
                          Content="30분 전"
                          IsChecked="{Binding VoiceReminder30Minutes, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditExecutionSettings}"
                          VerticalContentAlignment="Center" />
                <CheckBox Margin="0,0,24,0"
                          Content="10분 전"
                          IsChecked="{Binding VoiceReminder10Minutes, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditExecutionSettings}"
                          VerticalContentAlignment="Center" />
                <CheckBox Margin="0,0,24,0"
                          Content="5분 전"
                          IsChecked="{Binding VoiceReminder5Minutes, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditExecutionSettings}"
                          VerticalContentAlignment="Center" />
                <CheckBox Content="1분 전"
                          IsChecked="{Binding VoiceReminder1Minute, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditExecutionSettings}"
                          VerticalContentAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="3"
                      Margin="0,24,0,0">
            <TextBlock Foreground="#FF5C6470"
                       TextWrapping="Wrap"
                       Text="사용 금지 시간에는 설정을 바꿀 수 없습니다. 시간 외 사용 예약이나 긴급 해제로 사용 중이어도 변경할 수 없습니다." />
          </StackPanel>
          <StackPanel x:Name="ShellActions"
                      Grid.Row="4"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <Button Width="128"
                    Height="36"
                    Command="{Binding SaveExecutionSettingsCommand}"
                    Content="설정 저장"
                    FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem x:Name="WeeklyScheduleTab" Header="사용 금지 시각">
        <local:WeeklyScheduleView x:Name="WeeklyScheduleEditor" />
      </TabItem>
      <TabItem x:Name="EmergencyUnlockSettingsTab" Header="긴급 해제">
        <Grid Margin="22"
              IsEnabled="{Binding CanChangeUsagePolicySettings}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="1" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0"
                     VerticalAlignment="Center"
                     Text="긴급 해제 유지 시간" />
          <StackPanel Grid.Row="0"
                      Grid.Column="1"
                      Orientation="Horizontal">
            <TextBox Width="100"
                     MaxLength="2"
                     AutomationProperties.Name="긴급 해제 유지 시간"
                     behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                     HorizontalContentAlignment="Right"
                     InputMethod.IsInputMethodEnabled="False"
                     InputScope="Number"
                     Text="{Binding EmergencyDurationMinutesText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="분 (1~60분)" />
          </StackPanel>
          <TextBlock Grid.Row="2"
                     VerticalAlignment="Center"
                     Text="긴급 해제 문장 수" />
          <StackPanel Grid.Row="2"
                      Grid.Column="1"
                      Orientation="Horizontal">
            <TextBox Width="100"
                     MaxLength="2"
                     AutomationProperties.Name="긴급 해제 문장 수"
                     behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                     HorizontalContentAlignment="Right"
                     InputMethod.IsInputMethodEnabled="False"
                     InputScope="Number"
                     Text="{Binding EmergencySentenceCountText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="개 (0~99개, 0개면 문장 입력 없이 해제)" />
          </StackPanel>
          <Border Grid.Row="4"
                  Grid.ColumnSpan="2"
                  Background="#FFDDE1E6" />
          <CheckBox Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Content="긴급 해제 횟수 제한"
                    IsChecked="{Binding EmergencyWeeklyLimitEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" />
          <TextBlock Grid.Row="8"
                     VerticalAlignment="Center"
                     Text="초기화 요일" />
          <ComboBox Grid.Row="8"
                    Grid.Column="1"
                    Width="128"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="초기화 요일"
                    DisplayMemberPath="Value"
                    IsEnabled="{Binding EmergencyWeeklyLimitEnabled}"
                    ItemsSource="{Binding EmergencyWeeklyResetDays}"
                    SelectedValue="{Binding EmergencyWeeklyResetDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Key" />
          <TextBlock Grid.Row="10"
                     VerticalAlignment="Center"
                     Text="주간 최대 횟수" />
          <StackPanel Grid.Row="10"
                      Grid.Column="1"
                      IsEnabled="{Binding EmergencyWeeklyLimitEnabled}"
                      Orientation="Horizontal">
            <TextBox Width="100"
                     MaxLength="2"
                     AutomationProperties.Name="주간 최대 횟수"
                     behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                     HorizontalContentAlignment="Right"
                     InputMethod.IsInputMethodEnabled="False"
                     InputScope="Number"
                     Text="{Binding EmergencyWeeklyMaximumCountText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="회 (1~99회)" />
          </StackPanel>
          <TextBlock Grid.Row="12"
                     Grid.ColumnSpan="2"
                     Foreground="#FF5C6470"
                     Text="선택한 요일 자정에 사용 횟수가 초기화됩니다."
                     TextWrapping="Wrap" />
          <Button Grid.Row="14"
                  Grid.ColumnSpan="2"
                  Width="128"
                  Height="36"
                  HorizontalAlignment="Right"
                  Command="{Binding SaveEmergencyUnlockSettingsCommand}"
                  Content="설정 저장"
                  FontWeight="SemiBold" />
        </Grid>
      </TabItem>

      <TabItem Header="시간 외 사용 예약">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="True">
            <Button Width="112"
                    Height="32"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    IsEnabled="{Binding CanChangeUsagePolicySettings}"
                    Click="AddReservation_Click"
                    Content="예약 추가" />
          </DockPanel>
          <DataGrid Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="True"
                    CanUserResizeRows="False"
                    CanUserSortColumns="True"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding ReservationsView}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="130"
                                  Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"
                                  Header="날짜"
                                  SortMemberPath="Date" />
              <DataGridTextColumn Width="100"
                                  Binding="{Binding StartTime, StringFormat={}{0:HH:mm}}"
                                  Header="시작 시각"
                                  SortMemberPath="StartTime" />
              <DataGridTextColumn Width="100"
                                  Binding="{Binding EndTime, StringFormat={}{0:HH:mm}}"
                                  Header="종료 시각"
                                  SortMemberPath="EndTime" />
              <DataGridTextColumn Width="*"
                                  Binding="{Binding Memo}"
                                  Header="메모"
                                  SortMemberPath="Memo" />
              <DataGridTextColumn Width="90"
                                  Binding="{Binding ActiveStatusText}"
                                  Header="적용 중"
                                  SortMemberPath="IsActive" />
              <DataGridTemplateColumn Width="92" Header="관리">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Width="68"
                            Click="DeleteReservation_Click"
                            Content="삭제" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

  </Grid>
</Window>
