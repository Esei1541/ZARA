<Window x:Class="Zara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Zara.Desktop.Behaviors"
        Title="ZARA"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        Icon="Assets/ZaraIcon.png"
        Background="#FFF7F8FA"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel LastChildFill="True">
      <Border Width="52"
              Height="52"
              Margin="0,0,16,0"
              Padding="8"
              Background="#FF171A21"
              CornerRadius="12"
              DockPanel.Dock="Left">
        <Image Source="Assets/ZaraIcon.png" Stretch="Uniform" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="26"
                   FontWeight="SemiBold"
                   Text="ZARA" />
        <TextBlock Margin="0,2,0,0"
                   Foreground="#FF5C6470"
                   Text="{Binding UsagePolicyStatusMessage}" />
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="MainTabs"
                Grid.Row="2"
                SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="기본">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="실행 설정" />
          <CheckBox Grid.Row="2"
                    Command="{Binding ToggleRestartSettingCommand}"
                    Content="잠금이 해제된 상태에서도 프로그램이 종료되면 자동으로 다시 실행"
                    IsChecked="{Binding RestartOnExitWhenUnlocked, Mode=OneWay}"
                    IsEnabled="{Binding CanChangeSettings}"
                    VerticalContentAlignment="Center" />
          <StackPanel Grid.Row="3"
                      Margin="0,12,0,0">
            <TextBlock Foreground="#FF5C6470"
                       TextWrapping="Wrap"
                       Text="(시스템 트레이에서 직접 종료 시에는 실행되지 않습니다. 잠금 시각에는 설정과 관계 없이 실행됩니다.)" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#FF5C6470"
                       TextWrapping="Wrap"
                       Text="사용 금지 시간에는 설정을 바꿀 수 없습니다. 시간 외 사용 예약이나 긴급 해제로 사용 중이어도 변경할 수 없습니다." />
          </StackPanel>
          <StackPanel x:Name="ShellActions"
                      Grid.Row="4"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal" />
        </Grid>
      </TabItem>

      <TabItem x:Name="WeeklyScheduleTab" Header="사용 금지 시각">
        <Grid Margin="22"
              IsEnabled="{Binding CanChangeUsagePolicySettings}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Foreground="#FF5C6470"
                     TextWrapping="Wrap"
                     Text="시작 시각이 해제 시각보다 늦으면 다음 날 해제로 처리합니다. 시작과 해제 시각은 같게 설정할 수 없습니다." />
          <DataGrid x:Name="WeekdayRestrictionsGrid"
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding WeekdayRestrictions}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="120"
                                  Binding="{Binding DisplayName}"
                                  Header="요일"
                                  IsReadOnly="True" />
              <DataGridTemplateColumn Width="84" Header="사용">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox HorizontalAlignment="Center"
                              IsChecked="{Binding IsRestrictionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="*" Header="시작 시각">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                      <ComboBox Width="68"
                                ItemsSource="{Binding StartTime.Meridiems}"
                                SelectedItem="{Binding StartTime.Meridiem}" />
                      <TextBox Width="48"
                               Margin="6,0,0,0"
                               MaxLength="2"
                               AutomationProperties.Name="시작 시간"
                               behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                               HorizontalContentAlignment="Right"
                               InputMethod.IsInputMethodEnabled="False"
                               InputScope="Number"
                               Text="{Binding StartTime.HourText, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Margin="5,0"
                                 VerticalAlignment="Center"
                                 Text=":" />
                      <TextBox Width="48"
                               MaxLength="2"
                               AutomationProperties.Name="시작 분"
                               behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                               HorizontalContentAlignment="Right"
                               InputMethod.IsInputMethodEnabled="False"
                               InputScope="Number"
                               Text="{Binding StartTime.MinuteText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="*" Header="해제 시각">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                      <ComboBox Width="68"
                                ItemsSource="{Binding ReleaseTime.Meridiems}"
                                SelectedItem="{Binding ReleaseTime.Meridiem}" />
                      <TextBox Width="48"
                               Margin="6,0,0,0"
                               MaxLength="2"
                               AutomationProperties.Name="해제 시간"
                               behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                               HorizontalContentAlignment="Right"
                               InputMethod.IsInputMethodEnabled="False"
                               InputScope="Number"
                               Text="{Binding ReleaseTime.HourText, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Margin="5,0"
                                 VerticalAlignment="Center"
                                 Text=":" />
                      <TextBox Width="48"
                               MaxLength="2"
                               AutomationProperties.Name="해제 분"
                               behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                               HorizontalContentAlignment="Right"
                               InputMethod.IsInputMethodEnabled="False"
                               InputScope="Number"
                               Text="{Binding ReleaseTime.MinuteText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="4"
                  Width="128"
                  Height="36"
                  HorizontalAlignment="Right"
                  Command="{Binding SaveWeeklyScheduleCommand}"
                  Content="설정 저장"
                  FontWeight="SemiBold" />
        </Grid>
      </TabItem>

      <TabItem x:Name="EmergencyUnlockSettingsTab" Header="긴급 해제">
        <Grid Margin="22"
              IsEnabled="{Binding CanChangeUsagePolicySettings}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0"
                     VerticalAlignment="Center"
                     Text="긴급 해제 유지 시간" />
          <StackPanel Grid.Row="0"
                      Grid.Column="1"
                      Orientation="Horizontal">
            <TextBox Width="100"
                     MaxLength="2"
                     AutomationProperties.Name="긴급 해제 유지 시간"
                     behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                     HorizontalContentAlignment="Right"
                     InputMethod.IsInputMethodEnabled="False"
                     InputScope="Number"
                     Text="{Binding EmergencyDurationMinutesText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="분 (1~60분)" />
          </StackPanel>
          <TextBlock Grid.Row="2"
                     VerticalAlignment="Center"
                     Text="긴급 해제 문장 수" />
          <StackPanel Grid.Row="2"
                      Grid.Column="1"
                      Orientation="Horizontal">
            <TextBox Width="100"
                     MaxLength="2"
                     AutomationProperties.Name="긴급 해제 문장 수"
                     behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                     HorizontalContentAlignment="Right"
                     InputMethod.IsInputMethodEnabled="False"
                     InputScope="Number"
                     Text="{Binding EmergencySentenceCountText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="개 (0~99개, 0개면 문장 입력 없이 해제)" />
          </StackPanel>
          <Button Grid.Row="4"
                  Grid.ColumnSpan="2"
                  Width="128"
                  Height="36"
                  HorizontalAlignment="Right"
                  Command="{Binding SaveEmergencyUnlockSettingsCommand}"
                  Content="설정 저장"
                  FontWeight="SemiBold" />
        </Grid>
      </TabItem>

      <TabItem Header="시간 외 사용 예약">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="True">
            <Button Width="112"
                    Height="32"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    IsEnabled="{Binding CanChangeUsagePolicySettings}"
                    Click="AddReservation_Click"
                    Content="예약 추가" />
          </DockPanel>
          <DataGrid Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="True"
                    CanUserResizeRows="False"
                    CanUserSortColumns="True"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding ReservationsView}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="130"
                                  Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"
                                  Header="날짜"
                                  SortMemberPath="Date" />
              <DataGridTextColumn Width="100"
                                  Binding="{Binding StartTime, StringFormat={}{0:HH:mm}}"
                                  Header="시작 시각"
                                  SortMemberPath="StartTime" />
              <DataGridTextColumn Width="100"
                                  Binding="{Binding EndTime, StringFormat={}{0:HH:mm}}"
                                  Header="종료 시각"
                                  SortMemberPath="EndTime" />
              <DataGridTextColumn Width="*"
                                  Binding="{Binding Memo}"
                                  Header="메모"
                                  SortMemberPath="Memo" />
              <DataGridTextColumn Width="90"
                                  Binding="{Binding ActiveStatusText}"
                                  Header="적용 중"
                                  SortMemberPath="IsActive" />
              <DataGridTemplateColumn Width="92" Header="관리">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Width="68"
                            Click="DeleteReservation_Click"
                            Content="삭제" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

  </Grid>
</Window>
