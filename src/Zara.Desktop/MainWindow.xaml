<Window x:Class="Zara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZARA"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        Icon="Assets/ZaraIcon.png"
        Background="#FFF7F8FA"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel LastChildFill="True">
      <Border Width="52"
              Height="52"
              Margin="0,0,16,0"
              Padding="8"
              Background="#FF171A21"
              CornerRadius="12"
              DockPanel.Dock="Left">
        <Image Source="Assets/ZaraIcon.png" Stretch="Uniform" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="26"
                   FontWeight="SemiBold"
                   Text="ZARA" />
        <TextBlock Margin="0,2,0,0"
                   Foreground="#FF5C6470"
                   Text="{Binding UsagePolicyStatusMessage}" />
      </StackPanel>
    </DockPanel>

    <TabControl Grid.Row="2">
      <TabItem Header="기본">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="실행 설정" />
          <CheckBox Grid.Row="2"
                    Command="{Binding ToggleRestartSettingCommand}"
                    Content="정상 사용 시간에도 프로그램을 종료하면 다시 실행"
                    IsChecked="{Binding RestartOnExitWhenUnlocked, Mode=OneWay}"
                    IsEnabled="{Binding CanChangeSettings}"
                    VerticalContentAlignment="Center" />
          <TextBlock Grid.Row="3"
                     Margin="0,12,0,0"
                     Foreground="#FF5C6470"
                     TextWrapping="Wrap"
                     Text="사용 금지 시간에는 모든 설정 변경이 비활성화됩니다. 시간 외 사용 예약이나 긴급 해제가 적용 중이어도 같습니다." />
          <Button Grid.Row="4"
                  MinWidth="156"
                  Height="36"
                  Padding="16,0"
                  HorizontalAlignment="Right"
                  Command="{Binding StartLockDemoCommand}"
                  Content="오버레이 시연 시작"
                  FontWeight="SemiBold" />
        </Grid>
      </TabItem>

      <TabItem Header="사용 금지 시각">
        <Grid Margin="22"
              IsEnabled="{Binding CanChangeUsagePolicySettings}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Foreground="#FF5C6470"
                     TextWrapping="Wrap"
                     Text="시작 시각이 해제 시각보다 늦으면 다음 날 해제로 처리합니다. 시작과 해제 시각은 같게 설정할 수 없습니다." />
          <DataGrid Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding WeekdayRestrictions}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="120"
                                  Binding="{Binding DisplayName}"
                                  Header="요일"
                                  IsReadOnly="True" />
              <DataGridTemplateColumn Width="84" Header="사용">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox HorizontalAlignment="Center"
                              IsChecked="{Binding IsEnabled}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="*" Header="시작 시각">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel IsEnabled="{Binding IsEnabled}"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                      <ComboBox Width="68"
                                ItemsSource="{Binding StartTime.Meridiems}"
                                SelectedItem="{Binding StartTime.Meridiem}" />
                      <ComboBox Width="58"
                                Margin="6,0,0,0"
                                ItemsSource="{Binding StartTime.Hours}"
                                SelectedItem="{Binding StartTime.Hour}" />
                      <TextBlock Margin="5,0"
                                 VerticalAlignment="Center"
                                 Text=":" />
                      <ComboBox Width="58"
                                ItemsSource="{Binding StartTime.Minutes}"
                                SelectedItem="{Binding StartTime.Minute}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="*" Header="해제 시각">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel IsEnabled="{Binding IsEnabled}"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                      <ComboBox Width="68"
                                ItemsSource="{Binding ReleaseTime.Meridiems}"
                                SelectedItem="{Binding ReleaseTime.Meridiem}" />
                      <ComboBox Width="58"
                                Margin="6,0,0,0"
                                ItemsSource="{Binding ReleaseTime.Hours}"
                                SelectedItem="{Binding ReleaseTime.Hour}" />
                      <TextBlock Margin="5,0"
                                 VerticalAlignment="Center"
                                 Text=":" />
                      <ComboBox Width="58"
                                ItemsSource="{Binding ReleaseTime.Minutes}"
                                SelectedItem="{Binding ReleaseTime.Minute}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="4"
                  Width="128"
                  Height="36"
                  HorizontalAlignment="Right"
                  Command="{Binding SaveUsagePolicySettingsCommand}"
                  Content="설정 저장"
                  FontWeight="SemiBold" />
        </Grid>
      </TabItem>

      <TabItem Header="긴급 해제">
        <Grid Margin="22"
              IsEnabled="{Binding CanChangeUsagePolicySettings}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0"
                     Grid.ColumnSpan="2"
                     Foreground="#FF5C6470"
                     TextWrapping="Wrap"
                     Text="긴급 해제는 절전, 최대 절전, 앱 다시 시작, Windows 다시 시작 때 끝납니다." />
          <TextBlock Grid.Row="2"
                     VerticalAlignment="Center"
                     Text="긴급 해제 유지 시간" />
          <StackPanel Grid.Row="2"
                      Grid.Column="1"
                      Orientation="Horizontal">
            <ComboBox Width="100"
                      ItemsSource="{Binding EmergencyDurationMinuteOptions}"
                      SelectedItem="{Binding EmergencyDurationMinutes}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="분" />
          </StackPanel>
          <TextBlock Grid.Row="4"
                     VerticalAlignment="Center"
                     Text="긴급 해제 문장 수" />
          <StackPanel Grid.Row="4"
                      Grid.Column="1"
                      Orientation="Horizontal">
            <ComboBox Width="100"
                      ItemsSource="{Binding EmergencySentenceCountOptions}"
                      SelectedItem="{Binding EmergencySentenceCount}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="개 (0개면 문장 입력 없이 해제)" />
          </StackPanel>
          <Button Grid.Row="6"
                  Grid.ColumnSpan="2"
                  Width="128"
                  Height="36"
                  HorizontalAlignment="Right"
                  Command="{Binding SaveUsagePolicySettingsCommand}"
                  Content="설정 저장"
                  FontWeight="SemiBold" />
        </Grid>
      </TabItem>

      <TabItem Header="시간 외 사용 예약">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="True">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#FF5C6470"
                       Text="목록 머리글을 누르면 정렬 기준을 바꿀 수 있습니다. 지난 날짜의 예약은 옅게 표시됩니다." />
            <Button Width="112"
                    Height="32"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    IsEnabled="{Binding CanChangeUsagePolicySettings}"
                    Click="AddReservation_Click"
                    Content="예약 추가" />
          </DockPanel>
          <DataGrid Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="True"
                    CanUserResizeRows="False"
                    CanUserSortColumns="True"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding ReservationsView}">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsExpired}" Value="True">
                    <Setter Property="Foreground" Value="#FF9AA0A8" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Width="130"
                                  Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"
                                  Header="날짜"
                                  SortMemberPath="Date" />
              <DataGridTextColumn Width="100"
                                  Binding="{Binding StartTime, StringFormat={}{0:HH:mm}}"
                                  Header="시작 시각"
                                  SortMemberPath="StartTime" />
              <DataGridTextColumn Width="100"
                                  Binding="{Binding EndTime, StringFormat={}{0:HH:mm}}"
                                  Header="종료 시각"
                                  SortMemberPath="EndTime" />
              <DataGridTextColumn Width="*"
                                  Binding="{Binding Memo}"
                                  Header="메모"
                                  SortMemberPath="Memo" />
              <DataGridTextColumn Width="90"
                                  Binding="{Binding ActiveStatusText}"
                                  Header="적용 중"
                                  SortMemberPath="IsActive" />
              <DataGridTemplateColumn Width="92" Header="관리">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Width="68"
                            IsEnabled="{Binding CanDelete}"
                            Click="DeleteReservation_Click"
                            Content="삭제" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="4"
            Padding="12,8"
            Background="#FFE9EDF2"
            CornerRadius="6">
      <TextBlock Foreground="#FF38424F"
                 Text="{Binding OperationMessage}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
