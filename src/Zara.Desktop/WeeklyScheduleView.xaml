<UserControl x:Class="Zara.Desktop.WeeklyScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Zara.Desktop.Behaviors">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
      <SolidColorBrush x:Key="BulkBackground" Color="#F1EEFE" />
      <SolidColorBrush x:Key="BulkSelectedBackground" Color="#E4DDF8" />
      <SolidColorBrush x:Key="BulkBorder" Color="#D3C8F0" />
      <SolidColorBrush x:Key="BulkAccent" Color="#65518D" />
      <Style x:Key="BulkNavigationButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource BulkBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource BulkBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Zara.Brush.Text}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource Zara.Radius.Control}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BulkSelectedBackground}" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BulkAccent}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BulkAccent}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="{StaticResource Zara.Brush.Background}"
        TextElement.Foreground="{StaticResource Zara.Brush.Text}"
        TextElement.FontFamily="{StaticResource Zara.Font.Family}"
        TextElement.FontSize="14"
        IsEnabled="{Binding CanEditWeeklySchedule}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.85*" MinWidth="225" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="1.25*" MinWidth="290" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="사용 금지 시간대 설정" Style="{StaticResource Zara.SectionTitle}" />
          <TextBlock Text="요일에 따라 일정을 설정합니다." Margin="0,4,0,14" Style="{StaticResource Zara.SecondaryText}" />
          <RadioButton x:Name="BulkScheduleButton" Style="{StaticResource BulkNavigationButton}"
                        IsChecked="{Binding IsBulkScheduleSelected, Mode=OneWay}"
                        Command="{Binding SelectBulkScheduleCommand}"
                        AutomationProperties.Name="한 번에 적용">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="한 번에 적용" FontWeight="SemiBold" />
                <TextBlock Text="여러 요일을 한 번에 설정" Style="{StaticResource Zara.SecondaryText}" Margin="0,3,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource BulkAccent}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
          </RadioButton>
          <Border BorderBrush="{StaticResource Zara.Brush.Border}" BorderThickness="0,1,0,0" Margin="0,14,0,14" />
          <ListBox x:Name="WeekdayList" ItemsSource="{Binding WeekdayRestrictions}"
                   SelectedItem="{Binding SelectedWeekdayListItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   ItemContainerStyle="{StaticResource Zara.DayItem}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="사용 금지 시간대 설정">
            <ListBox.Template>
              <ControlTemplate TargetType="ListBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                  <ScrollViewer Focusable="False" CanContentScroll="True"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DisplayName}" Margin="0,0,10,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding CurrentSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ChangeStatus}" Style="{StaticResource Zara.SecondaryText}" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource Zara.Panel}" Padding="18" VerticalAlignment="Top">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding ScheduleEditorTitle}" Style="{StaticResource Zara.Heading}" FontSize="16" LineHeight="24" Margin="0,0,8,0" />
              <CheckBox x:Name="EnabledCheckBox" Grid.Column="1" Content="활성화" HorizontalAlignment="Right"
                        IsChecked="{Binding SelectedWeekday.IsRestrictionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsWeekdayScheduleSelected, Converter={StaticResource BooleanVisibility}}"
                        Style="{StaticResource Zara.CheckBox}" />
              <CheckBox x:Name="ActivateBulkWeekdaysCheckBox" Grid.Column="1" Content="적용 후 활성화" HorizontalAlignment="Right"
                        IsChecked="{Binding BulkScheduleEditor.ActivateAfterApply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsBulkScheduleSelected, Converter={StaticResource BooleanVisibility}}"
                        Style="{StaticResource Zara.CheckBox}" />
            </Grid>
            <StackPanel Visibility="{Binding IsBulkScheduleSelected, Converter={StaticResource BooleanVisibility}}">
              <TextBlock Text="선택한 요일에 같은 시간대를 설정합니다." Style="{StaticResource Zara.SecondaryText}" Margin="0,5,0,20" TextWrapping="Wrap" />
              <StackPanel DataContext="{Binding BulkScheduleEditor}">
                <DockPanel Margin="0,0,0,10">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="전체 선택" Command="{Binding SelectAllCommand}" Style="{StaticResource Zara.Button}" Padding="5,3" FontSize="12" Margin="0,0,5,0" />
                    <Button Content="선택 해제" Command="{Binding ClearSelectionCommand}" Style="{StaticResource Zara.Button}" Padding="5,3" FontSize="12" />
                  </StackPanel>
                  <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="적용할 요일" />
                    <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Zara.SecondaryText}" Margin="7,0,0,0" />
                  </WrapPanel>
                </DockPanel>
                <ItemsControl x:Name="BulkWeekdayTargets" ItemsSource="{Binding Targets}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ToggleButton Content="{Binding ShortName}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource Zara.TimeButton}" Padding="0,10" Margin="0,0,4,0"
                                    HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding DisplayName}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Border BorderBrush="{StaticResource Zara.Brush.Border}" BorderThickness="0,1,0,0" Margin="0,20,0,20" />
            </StackPanel>
            <DockPanel Margin="0,14" Visibility="{Binding IsWeekdayScheduleSelected, Converter={StaticResource BooleanVisibility}}">
              <Button x:Name="RevertButton" DockPanel.Dock="Right" Content="되돌리기"
                      Command="{Binding RevertWeekdayCommand}" Style="{StaticResource Zara.Button}" Padding="9,5" FontSize="12"
                      AutomationProperties.Name="선택한 요일을 저장값으로 되돌리기" />
              <TextBlock Text="{Binding SelectedWeekday.SavedDescription}" VerticalAlignment="Center"
                         TextWrapping="Wrap" Margin="0,0,8,0" Style="{StaticResource Zara.SecondaryText}" />
            </DockPanel>
            <StackPanel DataContext="{Binding ActiveScheduleTimeEditor}"
                        IsEnabled="{Binding DataContext.CanEditScheduleTime, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="StartTimeButton" GroupName="ScheduleEndpoint"
                             IsChecked="{Binding IsStartSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Zara.TimeButton}" AutomationProperties.Name="잠금 시작">
                  <StackPanel>
                    <TextBlock Text="잠금 시작" />
                    <TextBlock Text="{Binding StartTime.DisplayTime}" Style="{StaticResource Zara.TimeText}" />
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Zara.SecondaryText}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ReleaseTimeButton" Grid.Column="2" GroupName="ScheduleEndpoint"
                             IsChecked="{Binding IsReleaseSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Zara.TimeButton}" AutomationProperties.Name="잠금 해제">
                  <StackPanel>
                    <TextBlock Text="잠금 해제" />
                    <TextBlock Text="{Binding ReleaseTime.DisplayTime}" Style="{StaticResource Zara.TimeText}" />
                    <TextBlock Text="{Binding EndDay}" Style="{StaticResource Zara.SecondaryText}" />
                  </StackPanel>
                </RadioButton>
              </Grid>
              <TextBlock Text="{Binding DraftSummary}" Margin="0,16,0,28" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Slider x:Name="TimeSlider" Minimum="0" Maximum="1439" TickFrequency="15" SmallChange="1" LargeChange="15"
                      IsMoveToPointEnabled="True" Value="{Binding SelectedTime.MinutesSinceMidnight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{Binding SelectedTimeLabel}" Style="{StaticResource Zara.Slider}"
                      PreviewMouseLeftButtonDown="TimeSlider_PreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="TimeSlider_EndMouseAdjustment" LostMouseCapture="TimeSlider_EndMouseAdjustment"
                      PreviewKeyDown="TimeSlider_PreviewKeyDown" />
              <Grid Margin="0,8,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="00:00" HorizontalAlignment="Left" Style="{StaticResource Zara.SecondaryText}" />
                <TextBlock Text="06:00" Grid.ColumnSpan="2" HorizontalAlignment="Center" Style="{StaticResource Zara.SecondaryText}" />
                <TextBlock Text="12:00" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" Style="{StaticResource Zara.SecondaryText}" />
                <TextBlock Text="18:00" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Style="{StaticResource Zara.SecondaryText}" />
                <TextBlock Text="23:59" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource Zara.SecondaryText}" />
              </Grid>
              <UniformGrid Columns="4">
                <Button Content="−1시간" Command="{Binding EarlierHourCommand}" Style="{StaticResource Zara.Button}" Padding="4,8" Margin="0,0,7,0" />
                <Button Content="−30분" Command="{Binding EarlierHalfHourCommand}" Style="{StaticResource Zara.Button}" Padding="4,8" Margin="0,0,7,0" />
                <Button Content="+30분" Command="{Binding LaterHalfHourCommand}" Style="{StaticResource Zara.Button}" Padding="4,8" Margin="0,0,7,0" />
                <Button Content="+1시간" Command="{Binding LaterHourCommand}" Style="{StaticResource Zara.Button}" Padding="4,8" />
              </UniformGrid>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0" DataContext="{Binding SelectedTime}">
                <TextBlock Text="직접 입력" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="HourInput" Width="60" MaxLength="2" Style="{StaticResource Zara.TextBox}"
                         AutomationProperties.Name="시간" InputScope="Number" behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                         Text="{Binding HourText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         LostKeyboardFocus="TimeInput_LostKeyboardFocus" />
                <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0" />
                <TextBox x:Name="MinuteInput" Width="60" MaxLength="2" Style="{StaticResource Zara.TextBox}"
                         AutomationProperties.Name="분" InputScope="Number" behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                         Text="{Binding MinuteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         LostKeyboardFocus="TimeInput_LostKeyboardFocus" />
              </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding IsBulkScheduleSelected, Converter={StaticResource BooleanVisibility}}">
              <TextBlock Text="{Binding BulkScheduleEditor.ValidationMessage}" Style="{StaticResource Zara.ErrorText}" Margin="0,10,0,0" />
              <Button x:Name="ApplyBulkScheduleButton" Content="{Binding BulkScheduleEditor.ApplyButtonText}"
                      Command="{Binding ApplyBulkScheduleCommand}" Style="{StaticResource Zara.PrimaryButton}"
                      HorizontalAlignment="Right" Margin="0,14,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding WeeklyScheduleValidationMessage}" Style="{StaticResource Zara.ErrorText}" Margin="0,10,0,0" />
            <Border BorderBrush="{StaticResource Zara.Brush.Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
              <StackPanel>
                <TextBlock Text="저장 후 적용될 일정" Style="{StaticResource Zara.SecondaryText}" />
                <TextBlock x:Name="ImpactText" Text="{Binding WeeklyScheduleImpact}" FontSize="14" LineHeight="21" Margin="0,5,0,0" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Zara.Heading}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WillLockImmediately}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource Zara.Brush.Danger}" />
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="현재 시각이 잠금 시각에 포함되어 있습니다. 설정 시 즉시 잠금이 실행됩니다."
                           Style="{StaticResource Zara.SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Visibility="{Binding WillLockImmediately, Converter={StaticResource BooleanVisibility}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="1" Style="{StaticResource Zara.Panel}" Margin="22,0,22,18" Padding="15"
            Visibility="{Binding IsWeeklyScheduleConfirmationVisible, Converter={StaticResource BooleanVisibility}}">
      <StackPanel>
        <TextBlock Text="적용 시 바로 잠김" Foreground="{StaticResource Zara.Brush.Danger}" FontWeight="Bold" />
        <TextBlock Text="현재 시각이 잠금 시각에 포함되어 있습니다. 설정 시 즉시 잠금이 실행됩니다." Margin="0,6,0,12" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="63" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
          <TextBlock Text="{Binding WeeklyScheduleConfirmationSummary}" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal">
          <Button Content="계속 편집" Command="{Binding CancelWeeklyScheduleConfirmationCommand}" Style="{StaticResource Zara.Button}" Margin="0,0,8,0" />
          <Button x:Name="ConfirmSaveButton" Content="저장하고 지금 잠금" Command="{Binding ConfirmWeeklyScheduleCommand}" Style="{StaticResource Zara.PrimaryButton}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource Zara.Brush.Surface}" BorderBrush="{StaticResource Zara.Brush.Border}" BorderThickness="0,1,0,0" Padding="22,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="전체 변경 취소" Command="{Binding DiscardWeeklyScheduleCommand}" Style="{StaticResource Zara.Button}" Margin="0,0,8,0" />
          <Button x:Name="SaveButton" Content="일정 저장" Command="{Binding SaveWeeklyScheduleCommand}" Style="{StaticResource Zara.PrimaryButton}" />
        </StackPanel>
        <TextBlock Text="{Binding WeeklyScheduleChangeStatus}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
