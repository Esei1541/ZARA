<Window x:Class="Zara.Desktop.ReservationEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Zara.Desktop.Behaviors"
        Title="시간 외 사용 예약 추가"
        Width="520"
        MinWidth="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7F8FA">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="92" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0"
               Grid.Column="0"
               VerticalAlignment="Center"
               Text="날짜" />
    <DatePicker Grid.Row="0"
                Grid.Column="1"
                Width="180"
                HorizontalAlignment="Left"
                AutomationProperties.Name="예약 날짜"
                SelectedDate="{Binding SelectedDate}" />

    <TextBlock Grid.Row="2"
               Grid.Column="0"
               VerticalAlignment="Center"
               Text="시작 시각" />
    <StackPanel Grid.Row="2"
                Grid.Column="1"
                Orientation="Horizontal">
      <ComboBox Width="72"
                AutomationProperties.Name="시작 시각 오전 또는 오후"
                ItemsSource="{Binding StartTime.Meridiems}"
                SelectedItem="{Binding StartTime.Meridiem}" />
      <TextBox Width="52"
               Margin="8,0,0,0"
               MaxLength="2"
               AutomationProperties.HelpText="1부터 12까지 입력"
               AutomationProperties.Name="시작 시각 시간"
               behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
               HorizontalContentAlignment="Right"
               InputScope="Number"
               Text="{Binding StartTime.HourText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="6,0"
                 VerticalAlignment="Center"
                 Text=":" />
      <TextBox Width="52"
               MaxLength="2"
               AutomationProperties.HelpText="0부터 59까지 입력"
               AutomationProperties.Name="시작 시각 분"
               behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
               HorizontalContentAlignment="Right"
               InputScope="Number"
               Text="{Binding StartTime.MinuteText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="#FF5C6470"
                 Text="(1~12시, 0~59분)" />
    </StackPanel>

    <TextBlock Grid.Row="4"
               Grid.Column="0"
               VerticalAlignment="Center"
               Text="종료 시각" />
    <StackPanel Grid.Row="4"
                Grid.Column="1"
                Orientation="Horizontal">
      <ComboBox Width="72"
                AutomationProperties.Name="종료 시각 오전 또는 오후"
                ItemsSource="{Binding EndTime.Meridiems}"
                SelectedItem="{Binding EndTime.Meridiem}" />
      <TextBox Width="52"
               Margin="8,0,0,0"
               MaxLength="2"
               AutomationProperties.HelpText="1부터 12까지 입력"
               AutomationProperties.Name="종료 시각 시간"
               behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
               HorizontalContentAlignment="Right"
               InputScope="Number"
               Text="{Binding EndTime.HourText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="6,0"
                 VerticalAlignment="Center"
                 Text=":" />
      <TextBox Width="52"
               MaxLength="2"
               AutomationProperties.HelpText="0부터 59까지 입력"
               AutomationProperties.Name="종료 시각 분"
               behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
               HorizontalContentAlignment="Right"
               InputScope="Number"
               Text="{Binding EndTime.MinuteText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="#FF5C6470"
                 Text="(1~12시, 0~59분)" />
    </StackPanel>

    <TextBlock Grid.Row="6"
               Grid.Column="0"
               VerticalAlignment="Top"
               Text="메모" />
    <TextBox Grid.Row="6"
             Grid.Column="1"
             Height="76"
             AcceptsReturn="True"
             AutomationProperties.Name="예약 메모"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />

    <StackPanel Grid.Row="8"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button Width="88"
              IsDefault="True"
              Click="Save_Click"
              Content="등록" />
      <Button Width="88"
              Margin="8,0,0,0"
              IsCancel="True"
              Content="취소" />
    </StackPanel>
  </Grid>
</Window>
