<Window x:Class="Zara.Desktop.ReservationEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Zara.Desktop.Behaviors"
        Title="예약 추가"
        Width="510"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent" Language="ko-KR" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid TextElement.Foreground="{StaticResource Zara.Brush.Text}"
        TextElement.FontFamily="{StaticResource Zara.Font.Family}"
        TextElement.FontSize="14">
    <Border x:Name="DialogPanel"
            Background="{StaticResource Zara.Brush.Surface}"
            BorderBrush="{StaticResource Zara.Brush.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
      <StackPanel>
        <Grid Margin="0,0,0,22">
          <TextBlock Text="예약 추가" Style="{StaticResource Zara.SectionTitle}" VerticalAlignment="Center" />
          <Button HorizontalAlignment="Right" Style="{StaticResource Zara.DialogCloseButton}"
                  IsCancel="True" Content="×" AutomationProperties.Name="닫기" />
        </Grid>

        <TextBlock Text="날짜" FontWeight="SemiBold" Margin="0,0,0,8" />
        <DatePicker x:Name="ReservationDatePicker"
                    Style="{StaticResource Zara.DatePicker}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="예약 날짜"
                    SelectedDate="{Binding SelectedDate}" />

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="StartTimeCard" Grid.Column="0"
                  Background="{StaticResource Zara.Brush.Background}"
                  BorderBrush="{StaticResource Zara.Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="14">
            <StackPanel>
              <TextBlock Text="시작 시각" Style="{StaticResource Zara.SecondaryText}" Margin="0,0,0,10" />
              <StackPanel Orientation="Horizontal">
                <TextBox Width="55"
                         MaxLength="2"
                         FontSize="21"
                         Padding="5"
                         Style="{StaticResource Zara.TextBox}"
                         AutomationProperties.HelpText="0부터 23까지 입력"
                         AutomationProperties.Name="시작 시각 시간"
                         behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                         InputScope="Number"
                         Text="{Binding StartTime.HourText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text=":" FontSize="21" VerticalAlignment="Center" Margin="6,0" />
                <TextBox Width="55"
                         MaxLength="2"
                         FontSize="21"
                         Padding="5"
                         Style="{StaticResource Zara.TextBox}"
                         AutomationProperties.HelpText="0부터 59까지 입력"
                         AutomationProperties.Name="시작 시각 분"
                         behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                         InputScope="Number"
                         Text="{Binding StartTime.MinuteText, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="EndTimeCard" Grid.Column="2"
                  Background="{StaticResource Zara.Brush.Background}"
                  BorderBrush="{StaticResource Zara.Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="14">
            <StackPanel>
              <TextBlock Text="종료 시각" Style="{StaticResource Zara.SecondaryText}" Margin="0,0,0,10" />
              <StackPanel Orientation="Horizontal">
                <TextBox Width="55"
                         MaxLength="2"
                         FontSize="21"
                         Padding="5"
                         Style="{StaticResource Zara.TextBox}"
                         AutomationProperties.HelpText="0부터 23까지 입력"
                         AutomationProperties.Name="종료 시각 시간"
                         behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                         InputScope="Number"
                         Text="{Binding EndTime.HourText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text=":" FontSize="21" VerticalAlignment="Center" Margin="6,0" />
                <TextBox Width="55"
                         MaxLength="2"
                         FontSize="21"
                         Padding="5"
                         Style="{StaticResource Zara.TextBox}"
                         AutomationProperties.HelpText="0부터 59까지 입력"
                         AutomationProperties.Name="종료 시각 분"
                         behaviors:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                         InputScope="Number"
                         Text="{Binding EndTime.MinuteText, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource Zara.SecondaryText}"
                   Text="시각은 24시간을 기준으로 입력해주세요. (예: 오후 07:30 → 19:30)" />

        <TextBlock Text="메모" FontWeight="SemiBold" Margin="0,18,0,8" />
        <TextBox Height="78"
                 AcceptsReturn="True"
                 Style="{StaticResource Zara.TextBox}"
                 TextAlignment="Left"
                 HorizontalContentAlignment="Left"
                 VerticalContentAlignment="Top"
                 AutomationProperties.Name="예약 메모"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock x:Name="ValidationMessage"
                   Margin="0,10,0,0"
                   Style="{StaticResource Zara.ErrorText}"
                   AutomationProperties.LiveSetting="Assertive"
                   Visibility="Collapsed" />

        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Zara.Button}" IsCancel="True" Content="취소" />
          <Button x:Name="SaveButton" Margin="8,0,0,0" Style="{StaticResource Zara.PrimaryButton}"
                  IsDefault="True" Click="Save_Click" Content="예약 등록" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
