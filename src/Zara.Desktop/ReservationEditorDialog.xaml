<Window x:Class="Zara.Desktop.ReservationEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="시간 외 사용 예약 추가"
        Width="520"
        MinWidth="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7F8FA">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="92" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0"
               Grid.Column="0"
               VerticalAlignment="Center"
               Text="날짜" />
    <DatePicker Grid.Row="0"
                Grid.Column="1"
                Width="180"
                HorizontalAlignment="Left"
                SelectedDate="{Binding SelectedDate}" />

    <TextBlock Grid.Row="2"
               Grid.Column="0"
               VerticalAlignment="Center"
               Text="시작 시각" />
    <StackPanel Grid.Row="2"
                Grid.Column="1"
                Orientation="Horizontal">
      <ComboBox Width="72"
                ItemsSource="{Binding StartTime.Meridiems}"
                SelectedItem="{Binding StartTime.Meridiem}" />
      <ComboBox Width="64"
                Margin="8,0,0,0"
                ItemsSource="{Binding StartTime.Hours}"
                SelectedItem="{Binding StartTime.Hour}" />
      <TextBlock Margin="6,0"
                 VerticalAlignment="Center"
                 Text=":" />
      <ComboBox Width="64"
                ItemsSource="{Binding StartTime.Minutes}"
                SelectedItem="{Binding StartTime.Minute}" />
    </StackPanel>

    <TextBlock Grid.Row="4"
               Grid.Column="0"
               VerticalAlignment="Center"
               Text="종료 시각" />
    <StackPanel Grid.Row="4"
                Grid.Column="1"
                Orientation="Horizontal">
      <ComboBox Width="72"
                ItemsSource="{Binding EndTime.Meridiems}"
                SelectedItem="{Binding EndTime.Meridiem}" />
      <ComboBox Width="64"
                Margin="8,0,0,0"
                ItemsSource="{Binding EndTime.Hours}"
                SelectedItem="{Binding EndTime.Hour}" />
      <TextBlock Margin="6,0"
                 VerticalAlignment="Center"
                 Text=":" />
      <ComboBox Width="64"
                ItemsSource="{Binding EndTime.Minutes}"
                SelectedItem="{Binding EndTime.Minute}" />
    </StackPanel>

    <TextBlock Grid.Row="6"
               Grid.Column="0"
               VerticalAlignment="Top"
               Text="메모" />
    <TextBox Grid.Row="6"
             Grid.Column="1"
             Height="76"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />

    <StackPanel Grid.Row="8"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button Width="88"
              IsDefault="True"
              Click="Save_Click"
              Content="등록" />
      <Button Width="88"
              Margin="8,0,0,0"
              IsCancel="True"
              Content="취소" />
    </StackPanel>
  </Grid>
</Window>
