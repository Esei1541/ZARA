<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ZaraIcon.ico</ApplicationIcon>
    <AssemblyName>Zara.Desktop</AssemblyName>
    <RootNamespace>Zara.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zara.Application\Zara.Application.csproj" />
    <ProjectReference Include="..\Zara.Infrastructure.Windows\Zara.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ZaraIcon.ico" />
    <Resource Include="Assets\ZaraIcon.png" />
  </ItemGroup>
</Project>
