<UserControl x:Class="Zara.Desktop.Updates.ReleaseUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="SectionTitle" Text="업데이트" Style="{StaticResource Zara.SectionTitle}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="다시 확인" Style="{StaticResource Zara.Button}" Command="{Binding RefreshCommand}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="현재 버전" Style="{StaticResource Zara.SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock x:Name="CurrentVersionText" Text="{Binding CurrentVersion}" FontWeight="SemiBold" Foreground="{StaticResource Zara.Brush.Text}" />
      </StackPanel>
      <Border Style="{StaticResource Zara.Panel}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource Zara.Brush.AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
            <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Zara.Brush.Accent}"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Foreground="{StaticResource Zara.Brush.Text}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Text="최신 버전" Style="{StaticResource Zara.SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="{Binding LatestVersion}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Zara.Brush.Text}" />
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasError, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Text="{Binding ErrorDescription}" Style="{StaticResource Zara.SecondaryText}" TextWrapping="Wrap" />
              <TextBlock x:Name="ErrorCodeText" Text="{Binding ErrorCode}" FontFamily="Consolas" FontSize="12"
                         Foreground="{StaticResource Zara.Brush.Danger}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="InstallButton" Grid.Column="2" Content="업데이트 설치" Command="{Binding InstallCommand}"
                  Style="{StaticResource Zara.PrimaryButton}" Margin="18,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasUpdate, Converter={StaticResource VisibleWhenTrue}}" />
        </Grid>
      </Border>
      <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhenTrue}}">
        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}" />
        <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0}%}" Style="{StaticResource Zara.SecondaryText}" Margin="0,4,0,0" />
      </StackPanel>
      <TextBlock Text="{Binding OperationMessage}" Style="{StaticResource Zara.SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0"
                 Visibility="{Binding HasOperationMessage, Converter={StaticResource VisibleWhenTrue}}" />
      <StackPanel x:Name="ReleaseNotesPanel" Margin="0,24,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource VisibleWhenTrue}}">
        <Grid Margin="0,0,0,12">
          <TextBlock Text="업데이트 내역" Style="{StaticResource Zara.Heading}" />
          <TextBlock Text="GitHub Release" Style="{StaticResource Zara.SecondaryText}" HorizontalAlignment="Right" />
        </Grid>
        <Border Style="{StaticResource Zara.Panel}">
          <TextBlock x:Name="ReleaseNotesText" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Foreground="{StaticResource Zara.Brush.Text}" />
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
