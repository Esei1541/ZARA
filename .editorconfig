root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.ps1]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
